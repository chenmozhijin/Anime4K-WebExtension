{
  "name": "anime4k-webextension",
  "version": "0.4.0",
  "description": "Real-time video super-resolution browser extension based on Anime4K.",
  "scripts": {
    "build": "npm run build:chrome",
    "build:chrome": "cross-env TARGET_BROWSER=chrome webpack --mode production",
    "build:firefox": "cross-env TARGET_BROWSER=firefox webpack --mode production",
    "dev": "npm run dev:chrome",
    "dev:chrome": "cross-env TARGET_BROWSER=chrome webpack --mode development",
    "dev:firefox": "cross-env TARGET_BROWSER=firefox webpack --mode development",
    "watch:chrome": "cross-env TARGET_BROWSER=chrome webpack --mode development --watch",
    "watch:firefox": "cross-env TARGET_BROWSER=firefox webpack --mode development --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit-node --project dom --project integration",
    "test:unit": "vitest run --project unit-node",
    "test:dom": "vitest run --project dom",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit-node --project dom --project integration --coverage",
    "test:e2e:chromium": "npm run build:chrome && playwright test",
    "test:e2e:chromium:smoke": "npm run build:chrome && playwright test --grep @smoke",
    "test:e2e:chromium:matrix": "npm run build:chrome && playwright test --grep @site",
    "test:gpu:smoke": "npm run build:chrome && cross-env RUN_GPU_TESTS=1 playwright test --grep @gpu-smoke",
    "test:gpu:benchmark": "npm run build:chrome && cross-env RUN_GPU_TESTS=1 playwright test --grep @gpu-benchmark",
    "test:ci": "npm run typecheck && npm run test:unit && npm run test:dom && npm run test:integration && npm run build:chrome"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/chrome": "^0.0.326",
    "@types/node": "^24.12.2",
    "@vitest/coverage-v8": "^3.2.4",
    "@webgpu/types": "^0.1.69",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^13.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.5.4",
    "jsdom": "^26.1.0",
    "mini-css-extract-plugin": "^2.9.2",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "webpack": "^5.90.3",
    "webpack-cli": "^6.0.1",
    "webpack-extension-manifest-plugin": "^0.8.0",
    "webpack-target-webextension": "^2.1.3"
  }
}
