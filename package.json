{
  "name": "nijilucid",
  "version": "0.5.0",
  "description": "NijiLucid is a real-time video super-resolution browser extension powered by Anime4K.",
  "license": "MIT AND LGPL-3.0-or-later",
  "scripts": {
    "build": "npm run build:chrome",
    "build:chrome": "cross-env TARGET_BROWSER=chrome webpack --mode production",
    "build:firefox": "cross-env TARGET_BROWSER=firefox webpack --mode production",
    "dev": "npm run dev:chrome",
    "dev:chrome": "cross-env TARGET_BROWSER=chrome webpack --mode development",
    "dev:firefox": "cross-env TARGET_BROWSER=firefox webpack --mode development",
    "watch:chrome": "cross-env TARGET_BROWSER=chrome webpack --mode development --watch",
    "watch:firefox": "cross-env TARGET_BROWSER=firefox webpack --mode development --watch",
    "generate:acnet": "node scripts/generate-acnet.js",
    "generate:anime4k-cnn": "node scripts/generate-anime4k-cnn.js",
    "generate:cunny": "node scripts/generate-cunny.js",
    "fetch:references": "node scripts/fetch-reference-sources.js",
    "fetch:cunny-reference": "node scripts/fetch-cunny-reference.js",
    "verify:doctor": "node scripts/verify-doctor.js",
    "verify:setup-native": "node scripts/verify-setup-native.js",
    "verify:reference-libplacebo:doctor": "node scripts/verify-reference-libplacebo-doctor.js",
    "verify:reference-libplacebo:build-probe": "node scripts/build-libplacebo-probe.js",
    "verify:reference-libplacebo:probe": "node scripts/verify-reference-libplacebo-probe.js",
    "verify:reference-libplacebo:build-luma": "node scripts/build-libplacebo-luma-runner.js",
    "verify:reference-libplacebo:build-rgba": "node scripts/build-libplacebo-rgba-runner.js",
    "verify:reference-libplacebo:luma": "node scripts/verify-reference-libplacebo-luma.js",
    "verify:effects": "node scripts/verify-effects.js",
    "verify:texture-lifetimes": "node scripts/analyze-texture-lifetimes.js --output test-results/performance/texture-lifetimes.json",
    "verify:wgsl": "node scripts/verify-wgsl-compilation.js --quiet --output test-results/verify/wgsl-compilation.json",
    "verify:kernel-variants": "node scripts/verify-kernel-variants.js",
    "verify:external-texture": "node scripts/verify-external-texture.js",
    "verify:temporal": "node scripts/verify-temporal.js",
    "evaluate:visual-corpus": "node scripts/run-visual-corpus-matrix.js",
    "benchmark:gpu:full": "node scripts/benchmark-gpu-suite.js",
    "benchmark:gpu:matrix": "node scripts/benchmark-gpu-suite.js --variants baseline,exact,quantized,optimized --paired --warmup-ms 2000 --output test-results/performance/gpu-benchmark-matrix.json",
    "benchmark:gpu:flags": "node scripts/benchmark-gpu-suite.js --variants baseline --flag-variants --output test-results/performance/gpu-benchmark-flags.json",
    "benchmark:gpu:micro": "node scripts/benchmark-gpu-suite.js --micro depth-to-space --workload-id depth-to-space --variants baseline,optimized --output test-results/performance/gpu-benchmark-micro.json",
    "generate:video-fixtures": "node scripts/generate-video-fixtures.js",
    "benchmark:gpu:layers": "node scripts/benchmark-gpu-layers.js",
    "verify:preset-chains": "node scripts/verify-preset-chains.js",
    "verify:report": "node scripts/verify-report.js",
    "verify:optimization-report": "node scripts/verify-optimization-report.js",
    "check:production-bundle": "node scripts/check-production-bundle.js",
    "check:release-version": "node scripts/check-release-version.js --dist dist-chrome --dist dist-firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit-node --project dom --project integration",
    "test:unit": "vitest run --project unit-node",
    "test:dom": "vitest run --project dom",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit-node --project dom --project integration --coverage",
    "test:e2e:chromium": "npm run build:chrome && playwright test",
    "test:e2e:chromium:smoke": "npm run build:chrome && playwright test --grep @smoke",
    "test:e2e:chromium:matrix": "npm run build:chrome && playwright test --grep @site",
    "test:gpu:smoke": "npm run build:chrome && cross-env RUN_GPU_TESTS=1 playwright test --grep @gpu-smoke",
    "test:gpu:benchmark": "npm run build:chrome && cross-env RUN_GPU_TESTS=1 playwright test --grep @gpu-benchmark",
    "test:ci": "npm run typecheck && npm run test:coverage && npm run build:chrome && npm run build:firefox && npm run check:production-bundle && npm run check:release-version"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@webgpu/types": "^0.1.71",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "esbuild": "^0.28.1",
    "esbuild-loader": "^4.5.0",
    "html-webpack-plugin": "^5.6.7",
    "jsdom": "^29.1.1",
    "mini-css-extract-plugin": "^2.10.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "webpack": "^5.108.4",
    "webpack-cli": "^7.2.1",
    "webpack-extension-manifest-plugin": "^0.8.0",
    "webpack-target-webextension": "^2.1.3"
  }
}
