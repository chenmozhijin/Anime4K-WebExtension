# Keep dependency resolution on the public npm registry for this project.
registry=https://registry.npmjs.org/
strict-ssl=true

# Reject dependency sources that bypass the lockfile's normal registry flow.
allow-git=none
allow-remote=none
allow-file=root
allow-directory=root

# Avoid adopting packages immediately after publication.
min-release-age=7

# Require package.json allowScripts policy for every install hook.
strict-allow-scripts=true
