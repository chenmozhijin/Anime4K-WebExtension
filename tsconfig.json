{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["es2022", "dom"],
    "types": ["chrome", "@webgpu/types", "node"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "test-results",
    "coverage",
    "dist-*",
    ".cache",
    ".local-archive",
    ".reference",
    "experiment"
  ]
}
